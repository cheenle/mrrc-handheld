# Download proxy for this network.
#
# Measured from this host: https://github.com through the proxy answers in
# 1.3 s, direct in 14.0 s — the ESP-IDF component manager pulls 74 components
# for a xiaozhi-sized project, so this is the difference between a 3-minute and
# a 30-minute build.
#
# Consumed by tools/build_on_mac.sh (exported both locally and on the build
# host) and by tools/fetch.sh.  Nothing here is needed at run time: the
# firmware never talks to the internet except to the MRRC server.
#
#   set -a; . ./proxy.env; set +a        # use it in your own shell
MRRC_HTTP_PROXY="http://192.168.1.6:8888"

# Never proxy the local network: the MRRC server (192.168.1.217:8888), the
# build host (192.168.1.228) and the device (192.168.1.236) are all on the LAN.
MRRC_NO_PROXY="localhost,127.0.0.1,192.168.0.0/16,10.0.0.0/8,*.local,*.vlsc.net"
